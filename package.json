{
  "name": "n2-loom",
  "version": "1.0.0",
  "description": "Durable scoped AI dialogue with genuine streaming, tool execution and shared Soul storage.",
  "main": "dist/library.js",
  "types": "dist/library.d.ts",
  "bin": {
    "n2-loom": "dist/index.js"
  },
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "README.ko.md",
    "LICENSE",
    "LICENSE-*",
    "THIRD-PARTY-NOTICES"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --esModuleInterop --skipLibCheck false tests/consumer.cts tests/consumer.mts",
    "test": "npm run build && node --test --test-timeout=60000 tests/*.test.cjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/choihyunsus/n2-loom"
  },
  "dependencies": {
    "n2-hecaton": "https://github.com/choihyunsus/n2-hecaton/releases/download/v1.0.1/n2-hecaton-1.0.1.tgz",
    "n2-gumiho": "https://github.com/choihyunsus/n2-gumiho/releases/download/v1.0.1/n2-gumiho-1.0.1.tgz",
    "n2-recipe": "https://github.com/choihyunsus/n2-recipe/releases/download/v1.0.1/n2-recipe-1.0.1.tgz",
    "n2-mimir": "https://github.com/choihyunsus/n2-mimir/releases/download/v3.0.3/n2-mimir-3.0.3.tgz",
    "better-sqlite3": "^12.11.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9.3"
  }
}
